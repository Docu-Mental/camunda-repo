    <bpmn:sequenceFlow id="Flow_13iue7g" name="Yes" sourceRef="Gateway_04gbn1c" targetRef="Activity_03y5xye">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=terminologyValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1fbshrk" name="Approved?">
