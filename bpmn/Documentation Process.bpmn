    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_04gbn1c" name="Terminology Valid?">
      <bpmn:incoming>Flow_1fw3j5l</bpmn:incoming>
      <bpmn:outgoing>Flow_13iue7g</bpmn:outgoing>
      <bpmn:outgoing>Flow_0r95yfx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1fw3j5l" sourceRef="Activity_1qxe324" targetRef="Gateway_04gbn1c" />
    <bpmn:userTask id="Activity_03y5xye" name="Review document">
      <bpmn:extensionElements>
