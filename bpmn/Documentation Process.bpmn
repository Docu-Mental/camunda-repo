      <bpmn:outgoing>Flow_1vfydmy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_138ys41" sourceRef="Activity_03y5xye" targetRef="Gateway_1fbshrk" />
    <bpmn:sequenceFlow id="Flow_1peengo" name="Yes" sourceRef="Gateway_1fbshrk" targetRef="Activity_06gcatc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0r95yfx" name="No" sourceRef="Gateway_04gbn1c" targetRef="Activity_16bsnag">
